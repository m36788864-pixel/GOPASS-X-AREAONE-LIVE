# =========================================================
# GOPASS (PHP) — ตัวแปร env (มีสิทธิ์เหนือกว่า config.php)
# ตั้งที่ไหนก็ได้ที่โหลดเข้า process env (เช่น cPanel/ระบบ hosting)
# หรือจะกรอกลง config.php โดยตรงก็ได้
# =========================================================

# แอดมิน (ใช้เมื่อยังไม่มี data/admin.json)
ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Discord Login (OAuth2) - ต้องตั้ง redirect นี้ใน Discord Developer Portal ด้วย
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.com/api/auth/discord/callback

# บอท Discord สำหรับส่งโค้ดดูไลฟ์ให้ผู้ซื้อทาง DM (ใช้แอปเดียวกับ Discord Login ได้)
DISCORD_BOT_TOKEN=

# Webhook แจ้งเตือน (ไม่บังคับ)
DISCORD_WEBHOOK_URL=
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=

# ---- เชื่อมกับเว็บดูไลฟ์ AREAONE-LIVE (ออกโค้ดบัตร LIVE อัตโนมัติ) ----
# LIVE_API_URL ต้องถึงจากเครื่องที่รัน PHP ได้ (ถ้าเว็บไลฟ์อยู่คนละโดเมนก็ใส่โดเมนจริง)
LIVE_API_URL=https://YOUR-LIVE-SITE.com
# ค่าเดียวกับ INTEGRATION_SECRET ใน live/.env ของเว็บไลฟ์
LIVE_API_SECRET=
# ลิงก์หน้าที่ผู้ซื้อกดไปกรอกโค้ด
LIVE_SITE_URL=https://YOUR-LIVE-SITE.com
LIVE_CODE_PREFIX=AOL