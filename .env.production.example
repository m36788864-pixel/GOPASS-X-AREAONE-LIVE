# ---- ตัวอย่าง env สำหรับ deploy จริง (GOPASS PHP) ----
# กรอกค่าจริงใน config.php หรือ env ของ hosting ตามที่แสดง

ADMIN_USER=admin
ADMIN_PASS=CHANGE_THIS_TO_A_LONG_RANDOM_PASSWORD

# Discord Login (OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://YOUR-DOMAIN.com/api/auth/discord/callback

# บอท Discord สำหรับส่งโค้ดดูไลฟ์ทาง DM
DISCORD_BOT_TOKEN=

# Webhook (ไม่บังคับ)
GOOGLE_SHEET_WEBHOOK_URL=
GOOGLE_SHEET_SECRET=
DISCORD_WEBHOOK_URL=

# ---- เชื่อมกับเว็บดูไลฟ์ AREAONE-LIVE ----
LIVE_API_URL=https://YOUR-LIVE-SITE.com
LIVE_API_SECRET=
LIVE_SITE_URL=https://YOUR-LIVE-SITE.com
LIVE_CODE_PREFIX=AOL