NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://tdl:password@localhost:5432/tdl_live
# ถ้าฐานข้อมูลไม่รองรับ SSL (เช่น Postgres ใน Docker) ให้ตั้งเป็น false
DB_SSL=false
SESSION_TTL_HOURS=12
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ตั้งรหัสใหม่ตรงนี้

# CSP: report (default) or enforce after checking browser console
CSP_MODE=report
# Optional Discord webhook URLs; can be the same URL or separate channels
DISCORD_ALERT_WEBHOOK=
DISCORD_AUDIT_WEBHOOK=
# Minutes after a show ends before chat messages are deleted (default 30)
CHAT_CLEANUP_DELAY_MINUTES=30

# =========================================================
# เชื่อมกับเว็บกดบัตร GOPASS (ออกโค้ดอัตโนมัติเมื่อขายบัตร LIVE)
# ตั้งเป็นสตริงยาว ๆ สุ่ม แล้วนำค่าเดียวกันไปใส่ใน config.php ของ GOPASS
# (LIVE_API_SECRET) — ถ้าไม่ตั้ง endpoint /api/integration/* จะปิดไว้
# =========================================================
INTEGRATION_SECRET=
